default_platform(:ios)

ROOT = File.expand_path("../..", __dir__)
SECRETS = File.expand_path("~/.kidscare-secrets")
ENV_JSON = File.join(ROOT, "config/env.json")

# dart-define values (Mapbox token, ...) — copy config/env.example.json.
def require_env_json
  UI.user_error!("Missing #{ENV_JSON} — copy config/env.example.json and fill it in") unless File.exist?(ENV_JSON)
  UI.user_error!("MAPBOX_ACCESS_TOKEN is empty in #{ENV_JSON}") if JSON.parse(File.read(ENV_JSON))["MAPBOX_ACCESS_TOKEN"].to_s.empty?
end

# App Store Connect API key — files live OUTSIDE the repo.
# ~/.kidscare-secrets/asc.env must define ASC_KEY_ID and ASC_ISSUER_ID,
# and ~/.kidscare-secrets/AuthKey_<ASC_KEY_ID>.p8 must exist.
def asc_key
  env_file = File.join(SECRETS, "asc.env")
  File.readlines(env_file).each do |l|
    k, v = l.strip.split("=", 2).map { |s| s&.strip&.delete_prefix('"')&.delete_suffix('"') }
    ENV[k] ||= v if k && v && !k.empty? && !k.start_with?("#")
  end if File.exist?(env_file)
  UI.user_error!("Missing ASC_KEY_ID / ASC_ISSUER_ID in #{env_file}") unless ENV["ASC_KEY_ID"] && ENV["ASC_ISSUER_ID"]
  @p8 = File.join(SECRETS, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], key_filepath: @p8)
end

platform :ios do
  desc "Build signed IPA (Flutter + automatic signing)"
  lane :build do
    asc_key
    require_env_json
    # Build number = latest on TestFlight + 1, so uploads never collide.
    build_number = latest_testflight_build_number(app_identifier: "com.crosstechedu.kidscare", initial_build_number: 0) + 1
    UI.message("Build number: #{build_number}")
    # Homebrew fastlane sets GEM_PATH, which breaks Homebrew CocoaPods during `pod install`.
    sh("cd #{ROOT} && env -u GEM_HOME -u GEM_PATH flutter build ios --release --no-codesign --build-number=#{build_number} --dart-define-from-file=#{ENV_JSON}")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{ROOT}/build/ios/fastlane",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{@p8} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
